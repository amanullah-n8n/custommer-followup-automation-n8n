    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const lastContact = new Date(item.json['last contact date']);\n  const now = new Date();\n  const diffTime = now - lastContact;\n  const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));\n  \n  const status = (item.json['status'] || '').trim().toLowerCase();\n  \n  const needsFollowup = diffDays >= 3 && status === 'pending';\n  \n  result.push({\n    json: {\n      ...item.json,\n      diffDays: diffDays,\n      needsFollowup: needsFollowup\n    }\n  });\n}\n\nreturn result;"
      },
